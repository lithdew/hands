# Copy to .env (gitignored). Bun loads it automatically.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TYPESAFE_API_KEY=

# Also supported: OAI, ANT, GEMINI/GOOGLE_API_KEY/GOOGLE_CLOUD_API_KEY,
# JEV/JEV_API_KEY/jev_key. GOOGLE_CLOUD_API_KEY selects Vertex automatically.
# For a Vertex key in GEMINI or GEMINI_API_KEY, set GEMINI_BACKEND=vertex.
# GEMINI_BACKEND=ai-studio
# Voice always uses OpenAI; the agent provider can be changed in the panel.
PUK_PROVIDER=auto
# PUK_HAND=1
# PUK_PORT=7777
# PUK_MICROPHONE=
# OPENAI_MODEL=gpt-5.6-luna
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-3.8-flash
# MODEL pins a model; otherwise Jev chooses a model for each task.
# Jev selects low, medium or high effort; low is always the minimum.
# Optional stronger model for complex tasks (must be in Pi's catalog):
# OPENAI_COMPLEX_MODEL=gpt-6-astra
# ANTHROPIC_COMPLEX_MODEL=claude-sonnet-5
# GEMINI_COMPLEX_MODEL=gemini-3.8-flash
# TRANSCRIBE_MODEL=gpt-live-transcribe
# JEV_MODEL=jev-latest

# Opt-in bounded, redacted diagnostics for provider, Jev, Cua and microphone errors:
# PUK_DEBUG=1
