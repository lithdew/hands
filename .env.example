# Copy to .env (gitignored). Bun loads it automatically.
OPENAI_API_KEY=
GOOGLE_CLOUD_API_KEY=
TYPESAFE_API_KEY=

# Also supported: OAI, GEMINI/GEMINI_API_KEY/GOOGLE_API_KEY,
# JEV/JEV_API_KEY/jev_key. GOOGLE_CLOUD_API_KEY selects Vertex automatically.
# For a Vertex key in GEMINI or GEMINI_API_KEY, set GEMINI_BACKEND=vertex.
GEMINI_BACKEND=vertex
# AI Studio alternative: GEMINI_API_KEY=... and GEMINI_BACKEND=ai-studio.
# Voice always uses OpenAI; the agent provider can be changed in the panel.
PUK_PROVIDER=auto
# PUK_HAND=1
# PUK_PORT=7777
# PUK_MICROPHONE=
# OPENAI_MODEL=gpt-5.6-luna
# GEMINI_MODEL=gemini-3.8-flash
# The LLM pool is Luna, Gemini 3.8 Flash and Astra. Other models are rejected.
# MODEL pins a model within that pool; all routing profiles use low effort.
# Astra is always clamped to low, including explicit requests.
# OPENAI_COMPLEX_MODEL=gpt-6-astra
# OpenAI only: priority (default), flex, or off (omit service_tier).
# PUK_SERVICE_TIER takes precedence over the pi-tier-compatible PI_TIER alias.
PUK_SERVICE_TIER=priority
# TRANSCRIBE_MODEL=gpt-live-transcribe
# JEV_MODEL=jev-latest
# Progress captions run beside the worker on changed events (default: enabled).
# PUK_NARRATION=0
# Structured local run timings in out/runs (default: enabled; no task/tool text).
# PUK_RUN_TRACE=0

# Opt-in debug diagnostics; known secrets are redacted, but task/tool text may remain:
# PUK_DEBUG=1
